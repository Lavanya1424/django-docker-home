pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub project checked out'
            }
        }

        stage('Build') {
            steps {
                echo 'Docker build will be added later'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Docker deployment will be added later'
            }
        }
    }
}